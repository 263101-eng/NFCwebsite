<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>키 투 스타트 — 차 키 레이스</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,800&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--ink:#000;--mute:#5b5650;--panel:#f3f1ee;--line:#d9d4cc;--red:#a4262c;--gold:#c9a24b;--onink:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c0c0c;--ink:#f4f0e8;--mute:#a39d92;--panel:#1b1a19;--line:#34312d;--onink:#000}}
:root[data-theme="dark"]{--bg:#0c0c0c;--ink:#f4f0e8;--mute:#a39d92;--panel:#1b1a19;--line:#34312d;--onink:#000}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Noto Sans KR',system-ui,sans-serif;line-height:1.5}
header{padding:14px 18px;border-bottom:1px solid var(--line);font:italic 800 22px 'Barlow Condensed','Noto Sans KR',sans-serif}
main{max-width:900px;margin:0 auto;padding:12px 14px 20px}
h1{font:italic 800 28px/1 'Barlow Condensed','Noto Sans KR',sans-serif;margin:0 0 6px}
.sub{color:var(--mute);margin:0 0 14px;font-size:14px}
#cv{display:block;width:min(100%,calc(66vh*1.7778));height:auto;aspect-ratio:16/9;margin:0 auto;border:3px solid #000;touch-action:none;background:#000}
.hint{min-height:24px;margin:8px 0;text-align:center;font-weight:700;font-size:15px}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;max-width:520px;margin:0 auto}
.kb{background:var(--panel);border:0;border-bottom:5px solid var(--gold);color:var(--ink);padding:10px 2px 8px;cursor:pointer;font:500 12px 'Noto Sans KR',sans-serif;display:flex;flex-direction:column;align-items:center;gap:4px}
.pad{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:8px;max-width:520px;margin:0 auto}
.pad button,.swap{border:2px solid var(--ink);background:none;color:var(--ink);padding:12px 0;font:700 16px 'Noto Sans KR',sans-serif;cursor:pointer;touch-action:none;user-select:none;-webkit-user-select:none}
.pad #st{background:var(--red);border-color:var(--red);color:#fff;letter-spacing:.08em}
.pad button:disabled{opacity:.5;cursor:default}
.swap{margin:8px auto 0;display:block;width:100%;max-width:520px;padding:10px 0;font-size:14px}
[hidden]{display:none!important}
button:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
</style>
</head>
<body>
<header>KEY TO START</header>
<main>
<h1>키를 꽂고 시동, 그다음 출발</h1>
<p class="sub">차 키를 시동 장치에 꽂으면 엔진이 걸립니다. START를 누르면 출발해요.</p>
<canvas id="cv" width="800" height="450" aria-label="운전석 시점 레이싱 게임 화면"></canvas>
<p class="hint" id="hint" aria-live="polite"></p>
<div class="keys" id="keys"></div>
<div class="pad" id="pad" hidden><button id="bl" aria-label="왼쪽으로 핸들 꺾기">◀</button><button id="st">START</button><button id="br" aria-label="오른쪽으로 핸들 꺾기">▶</button></div>
<button class="swap" id="swap" hidden>키 바꾸기</button>
</main>
<script>
var $=function(i){return document.getElementById(i)},cv=$('cv'),x=cv.getContext('2d'),W=800,H=450,cx=400,hy=150,by=315,sw=300,WY=430,SX=110,SY=345;
var KEYS=[{n:'블랙',c:'#111',a:'#c9a24b'},{n:'로소 레드',c:'#a4262c',a:'#e6cf94'},{n:'골드',c:'#c9a24b',a:'#000'},{n:'스트라이프',c:'#2a2a2a',a:'#a4262c'}];
var S={st:'pick',k:null,ins:0,lit:0,rpm:0,fl:0,v:0,dist:0,cam:0,steer:0,yaw:0,lane:1,cs:0,pv:0,tun:0,obs:[],nz:30,best:0,fx:0,t:0,on:false},K={l:0,r:0},lg=new Image(),ac,osc,gn;
lg.src='data:image/png;base64,';
var LN=[-1.05,-.35,.35,1.05];try{S.best=+localStorage.getItem('kk2')||0}catch(e){}
function fob(k){return '<svg viewBox="0 0 44 110" width="40" aria-hidden="true"><rect x="19" y="0" width="6" height="18" fill="#c8c8c8"/><rect x="1" y="16" width="42" height="72" rx="14" fill="#bdbdbd"/><rect x="3" y="18" width="38" height="68" rx="12" fill="'+k.c+'"/><path d="M3 32Q3 18 17 18H32L3 60Z" fill="#fff" fill-opacity=".1"/><rect x="6" y="21" width="32" height="62" rx="10" fill="none" stroke="'+k.a+'" stroke-opacity=".7"/><rect x="9" y="24" width="8" height="6" rx="3" fill="#000" fill-opacity=".4"/><rect x="18" y="24" width="8" height="6" rx="3" fill="#000" fill-opacity=".4"/><rect x="27" y="24" width="8" height="6" rx="3" fill="#000" fill-opacity=".4"/><circle cx="22" cy="55" r="17" fill="#0a0a0a" stroke="#bdbdbd" stroke-width="1.5"/><image href="'+lg.src+'" x="10" y="40.5" width="24" height="29"/><circle cx="22" cy="99" r="8" fill="none" stroke="#c9a24b" stroke-width="3"/></svg>'}
$('keys').innerHTML=KEYS.map(function(k,i){return '<button class="kb" data-i="'+i+'">'+fob(k)+k.n+'</button>'}).join('');
function ui(){var s=S.st;$('keys').hidden=s!='pick';$('pad').hidden=s=='pick'||s=='ins';$('swap').hidden=!(s=='ready'||s=='over');var b=$('st');b.disabled=!(s=='ready'||s=='over');b.textContent=s=='drive'?'RUN':s=='over'?'다시 출발':'START';
$('hint').textContent={pick:'차 키를 골라 시동 장치에 꽂으세요.',ins:'키를 꽂는 중…',ready:'시동 ON. START 버튼을 누르면 출발합니다.',drive:'◀ ▶ 버튼, 방향키, 화면 좌우 터치로 차선을 바꿔 장애물을 피하세요. 커브는 차가 알아서 돕니다.',over:'충돌! '+Math.floor(S.dist)+'m 주행했어요.'}[s]}
function snd(){try{ac=ac||new(window.AudioContext||window.webkitAudioContext)();if(!osc){osc=ac.createOscillator();gn=ac.createGain();osc.type='sawtooth';gn.gain.value=0;osc.connect(gn);gn.connect(ac.destination);osc.start()}}catch(e){}}
$('keys').onclick=function(e){var b=e.target.closest('.kb');if(!b)return;S.k=KEYS[b.dataset.i];S.st='ins';S.ins=0;snd();ui()};
$('st').onclick=function(){if(S.st=='ready'||S.st=='over'){S.dist=0;S.v=0;S.obs=[];S.nz=30;S.lane=1;S.cam=-.35;S.st='drive';ui()}};
$('swap').onclick=function(){S.st='pick';S.on=false;S.k=null;S.v=0;S.obs=[];ui()};
function mv(d){if(S.st=='drive')S.lane=Math.max(0,Math.min(3,S.lane+d))}
function hold(id,d){$(id).addEventListener('pointerdown',function(e){e.preventDefault();mv(d)})}
hold('bl',-1);hold('br',1);
cv.addEventListener('pointerdown',function(e){var r=cv.getBoundingClientRect();mv(e.clientX<r.left+r.width/2?-1:1)});
addEventListener('keydown',function(e){var k=e.key;if(k=='ArrowLeft'||k=='a'||k=='A'){if(!e.repeat)mv(-1);e.preventDefault()}else if(k=='ArrowRight'||k=='d'||k=='D'){if(!e.repeat)mv(1);e.preventDefault()}});
function crash(){S.st='over';S.fx=1;var d=Math.floor(S.dist);if(d>S.best){S.best=d;try{localStorage.setItem('kk2',d)}catch(e){}}ui()}
function step(dt){S.t+=dt;S.lit+=((S.on?1:0)-S.lit)*Math.min(1,3*dt);
if(S.st=='ins'){S.ins+=dt/.8;if(S.ins>=1){S.ins=1;S.on=true;S.fl=1;S.st='ready';ui()}}
if(S.fl>0)S.fl-=dt*.9;if(S.fx>0)S.fx-=dt*1.5;
var dr=S.st=='drive';
if(dr){S.v+=(Math.min(24,10+S.dist/70)-S.v)*Math.min(1,2.2*dt);S.dist+=S.v*dt}else S.v=Math.max(0,S.v-(S.v*3+.5)*dt);
var pc=S.cam;if(dr)S.cam+=(LN[S.lane]-S.cam)*Math.min(1,9*dt);var vl=(S.cam-pc)/(dt||.016);S.steer+=(Math.max(-1,Math.min(1,vl*.25))-S.steer)*Math.min(1,10*dt);S.yaw+=(S.steer-S.yaw)*Math.min(1,4*dt);S.cs+=(cvv(S.dist)/.014-S.cs)*Math.min(1,5*dt);S.pv+=(gz(S.dist)-S.pv)*Math.min(1,4*dt);var wt=S.dist+6,ft=wt/220%1;S.tun+=(((zn(wt)==2&&ft>.1&&ft<.9)?1:0)-S.tun)*Math.min(1,3*dt);var tp=PL[bi(S.dist+40)];for(var pi=0;pi<31;pi++)S.pal[pi]+=(tp[pi]-S.pal[pi])*Math.min(1,.8*dt);
if(dr){
while(S.dist+45>=S.nz){var li=Math.floor(Math.random()*4);S.obs.push({l:LN[li],z:S.nz,t:Math.random()<.7?0:1});if(Math.random()<.45)S.obs.push({l:LN[(li+1+Math.floor(Math.random()*3))%4],z:S.nz,t:0});S.nz+=15+Math.random()*8-Math.min(4,S.dist/500)}
for(var i=S.obs.length-1;i>=0;i--){var o=S.obs[i],z=1+o.z-S.dist;if(z<.55)S.obs.splice(i,1);else if(z<1.3&&z>.7&&Math.abs(o.l-S.cam)<(o.t?.35:.25)+.2){crash();break}}}
S.rpm+=((S.on?.14+.72*S.v/24+Math.max(0,S.fl)*.6:0)-S.rpm)*Math.min(1,6*dt);
if(osc){osc.frequency.value=38+S.rpm*150;gn.gain.value=S.on?.03:0}}
var CU=[],EL=[];
function hs(i){var h=Math.sin(i*127.1+311.7)*43758.5453;return h-Math.floor(h)}
function cvv(w){var i=Math.floor(w/170),f=w/170-i,r=hs(i+3),d=i<1?0:r<.28?-1:r<.56?1:0,q=Math.sin(Math.PI*f);return d*q*q*.014}
function zn(w){var i=Math.floor(w/220);return i<1?0:[0,2,0,1,0,2,1,0,2,0,1,2][i%12]}
function gz(w){var f=w/220-Math.floor(w/220),z=zn(w);return z==1?.09*Math.sin(6.2832*f):z==2?-.09*Math.sin(6.2832*f):0}
function ip(A,d){d=Math.max(0,Math.min(60,d));var i=Math.floor(d),f=d-i;return A[i]+(A[Math.min(60,i+1)]-A[i])*f}
var bo=0,PAL=['#1b1535','#241a45','#2d2160','#171230'],NEON=['#ff3d8b','#35e0ff','#ffb347','#b36bff'];
function skyl(w0,hm,col,par,win,seed){for(var i=-6;i<W/w0+8;i++){var bh=12+(Math.abs(i*37+seed)%23)*hm,bx=i*w0-S.cam*par+bo*par/8-w0*2;x.fillStyle=col;x.fillRect(bx,hy-bh,w0-3,bh);if(win){x.fillStyle='rgba(255,205,110,.55)';for(var j=0;j<bh/8;j++)if((i+j+seed+60)%3==0)x.fillRect(bx+3,hy-bh+4+j*8,2,3);if(bh>45&&i%5==0){x.fillStyle=(S.t*2|0)%2?'#ff3b30':'#7a1b1b';x.fillRect(bx+(w0-3)/2-1,hy-bh-8,2,8)}}}}
function city(m,z1,z2){if(z1>45)return;var id=Math.floor(m/4),sb=m%4;x.globalAlpha=Math.min(1,(46-z1)/24);
for(var sd=-1;sd<2;sd+=2){
if(sb<3){var hh=1.6+hs(id*2+(sd>0?1:0)+50)*4.8,bw=1.4+hs(id*3+sd+90)*1.6,l1=sd*1.9,l2=sd*(1.9+bw),col=PAL[Math.floor(hs(id+sd*7)*4)],ne=NEON[Math.floor(hs(id*5+sd)*4)];
poly([P3(l1,0,z1),P3(l1,hh,z1),P3(l1,hh,z2),P3(l1,0,z2)],col);
if(sb==0)poly([P3(l1,0,z1),P3(l1,hh,z1),P3(l2,hh,z1),P3(l2,0,z1)],'#2f2468');
poly([P3(l1,hh,z1),P3(l1,hh+.07,z1),P3(l1,hh+.07,z2),P3(l1,hh,z2)],ne);
if(z1<30)for(var r=0;r*.55+.4<hh;r++)if(hs(id*13+r*7+sb+sd*3)>.42){var hz=.55*r+.3,wc=hs(id+r);poly([P3(l1,hz,z1+.4),P3(l1,hz+.28,z1+.4),P3(l1,hz+.28,z2-.4),P3(l1,hz,z2-.4)],wc>.6?'#ffe9b0':wc>.3?'#ffd27a':'#7fe6ff')}}
if(sb%2==0&&z1>1.2){var a=P3(sd*1.72,0,z1),b=P3(sd*1.72,.9,z1);x.strokeStyle='#3a3a44';x.lineWidth=Math.max(1,3/z1);x.beginPath();x.moveTo(a[0],a[1]);x.lineTo(b[0],b[1]);x.stroke();x.fillStyle='rgba(255,200,120,.16)';x.beginPath();x.arc(b[0],b[1],Math.max(4,22/z1),0,7);x.fill();x.fillStyle='rgba(255,225,150,.95)';x.beginPath();x.arc(b[0],b[1],Math.max(1.5,6/z1),0,7);x.fill()}}
x.globalAlpha=1}
var PL=[[10,7,32,42,16,80,164,38,44,255,154,90,53,20,90,42,15,58,7,4,13,255,224,138,224,54,106,1,1,1,0],[18,40,92,63,99,176,255,143,143,255,217,160,58,74,140,27,79,138,10,42,82,255,242,176,255,122,106,1,0,.45,0],[27,42,78,91,111,168,232,167,181,255,215,168,63,77,122,47,74,58,20,38,28,255,240,192,255,179,107,0,0,2.6,1],[43,111,214,111,179,242,201,230,255,255,241,214,91,122,166,63,125,70,31,74,42,255,251,224,255,226,122,0,0,2.2,0]],BN=['도시','해안','산','고속도로'];
S.pal=PL[0].slice();
function bi(w){return Math.floor(w/420)%4}
function C(o){var p=S.pal;return 'rgb('+(p[o]|0)+','+(p[o+1]|0)+','+(p[o+2]|0)+')'}
function palm(l,z1,sd){var b=P3(l,0,z1),t=P3(l+sd*.06,1.15,z1);x.strokeStyle='#6b4a2b';x.lineWidth=Math.max(1,5/z1);x.beginPath();x.moveTo(b[0],b[1]);x.lineTo(t[0],t[1]);x.stroke();x.strokeStyle='#1f8a4a';x.lineWidth=Math.max(1.5,5/z1);for(var k=-2;k<3;k++){var e=P3(l+sd*.06+k*.3,1-Math.abs(k)*.1,z1);x.beginPath();x.moveTo(t[0],t[1]);x.lineTo(e[0],e[1]);x.stroke()}}
function tree(l,z1){var b=P3(l,0,z1),t=P3(l,.8,z1),r=Math.max(2,.42*sw/z1);x.strokeStyle='#5a3d22';x.lineWidth=Math.max(1,4/z1);x.beginPath();x.moveTo(b[0],b[1]);x.lineTo(t[0],t[1]);x.stroke();x.fillStyle='#1d5a30';x.beginPath();x.arc(t[0],t[1]-r*.4,r,0,7);x.fill();x.fillStyle='#2b7a43';x.beginPath();x.arc(t[0]-r*.3,t[1]-r*.6,r*.6,0,7);x.fill()}
function boat(a,z1){poly([P3(a,.12,z1),P3(a+.7,.12,z1),P3(a+.55,0,z1),P3(a+.15,0,z1)],'#e9e9ef');poly([P3(a+.3,1,z1),P3(a+.3,.14,z1),P3(a+.65,.14,z1)],'#fff')}
function sea(m,z1,z2){var c=m%2?'#1f6aa5':'#1b5f96';quad(-14,-1.52,z1,z2,c);quad(1.52,14,z1,z2,c);if(z1>46)return;x.globalAlpha=Math.min(1,(46-z1)/24);
for(var sd=-1;sd<2;sd+=2){var h=hs(m*3+sd+7);if(h>.5){var a=sd*(2+hs(m+sd)*9);poly([P3(a,0,z1+.2),P3(a+sd*.9,0,z1+.2),P3(a+sd*.9,0,z1+.55),P3(a,0,z1+.55)],'rgba(255,225,170,.5)')}
if(h>.92&&z1>4)boat(sd*(4+hs(m)*7),z1);if(m%3==0&&z1>1.2)palm(sd*1.85,z1,sd)}x.globalAlpha=1}
function hwy(m,z1,z2){var c=m%2?'#3f7d46':'#3a7340';quad(-14,-1.52,z1,z2,c);quad(1.52,14,z1,z2,c);if(z1>46)return;x.globalAlpha=Math.min(1,(46-z1)/24);
for(var sd=-1;sd<2;sd+=2){poly([P3(sd*1.62,.3,z1),P3(sd*1.62,.3,z2),P3(sd*1.62,.2,z2),P3(sd*1.62,.2,z1)],'#cfd3da');if(m%2==0)poly([P3(sd*1.62,0,z1),P3(sd*1.62,.3,z1),P3(sd*1.66,.3,z1),P3(sd*1.66,0,z1)],'#8a8f99');
if(m%2==0&&z1>1.2&&hs(m*5+sd)>.35)tree(sd*(2.4+hs(m+sd*3)*5),z1);
if(m%40==0&&z1>1.1&&sd<0){poly([P3(-1.75,0,z1),P3(-1.75,2,z1),P3(-1.67,2,z1),P3(-1.67,0,z1)],'#777');poly([P3(1.67,0,z1),P3(1.67,2,z1),P3(1.75,2,z1),P3(1.75,0,z1)],'#777');poly([P3(-1.75,1.35,z1),P3(1.75,1.35,z1),P3(1.75,2,z1),P3(-1.75,2,z1)],'#12633c');poly([P3(-1.4,1.75,z1),P3(1.4,1.75,z1),P3(1.4,1.82,z1),P3(-1.4,1.82,z1)],'#fff');poly([P3(-1,1.55,z1),P3(.6,1.55,z1),P3(.6,1.62,z1),P3(-1,1.62,z1)],'#fff')}}x.globalAlpha=1}
function pine(l,z1){poly([P3(l-.06,0,z1),P3(l-.06,.35,z1),P3(l+.06,.35,z1),P3(l+.06,0,z1)],'#4a3220');for(var k=0;k<3;k++){var hk=.3+.45*k,w=.58-.14*k;poly([P3(l-w,hk,z1),P3(l+w,hk,z1),P3(l,hk+.7,z1)],k%2?'#1f5a3a':'#17492e')}}
function mtn(m,z1,z2){var c=m%2?'#2f4a3a':'#2a4234';quad(-14,-1.52,z1,z2,c);quad(1.52,14,z1,z2,c);if(z1>46)return;x.globalAlpha=Math.min(1,(46-z1)/24);
if(m%2==1&&z1>1.2&&hs(m*7+3)>.4)pine(-(3.6+hs(m+9)*4),z1);
var ch=1.2+hs(Math.floor(m/2)+31)*1.8;poly([P3(-1.9,0,z1),P3(-1.9,ch,z1),P3(-1.9,ch,z2),P3(-1.9,0,z2)],m%2?'#4a4f66':'#565b73');poly([P3(-1.9,ch,z1),P3(-1.9,ch+.06,z1),P3(-1.9,ch+.06,z2),P3(-1.9,ch,z2)],'#e8eefc');
poly([P3(1.62,.3,z1),P3(1.62,.3,z2),P3(1.62,.2,z2),P3(1.62,.2,z1)],'#cfd3da');
if(m%2==0&&z1>1.2&&hs(m*7+2)>.25)pine(2.3+hs(m)*4,z1);x.globalAlpha=1}
function scene(m,z1,z2,wz){var b=bi(wz);if(b==0)city(m,z1,z2);else if(b==1)sea(m,z1,z2);else if(b==2)mtn(m,z1,z2);else hwy(m,z1,z2)}
function P3(l,h,z){return [X(l,z),Y(z)-h*sw/z]}
function poly(a,c){x.fillStyle=c;x.beginPath();x.moveTo(a[0][0],a[0][1]);for(var i=1;i<a.length;i++)x.lineTo(a[i][0],a[i][1]);x.fill()}
function rr(a,b,w,h,r,c){x.fillStyle=c;x.beginPath();if(x.roundRect)x.roundRect(a,b,w,h,r);else x.rect(a,b,w,h);x.fill()}
function Y(z){return hy+(by-hy-ip(EL,z-1)*sw)/z}
function X(l,z){return cx+(l-S.cam-ip(CU,z-1))*sw/z}
function quad(l1,l2,za,zb,c){x.fillStyle=c;x.beginPath();x.moveTo(X(l1,za),Y(za));x.lineTo(X(l2,za),Y(za));x.lineTo(X(l2,zb),Y(zb));x.lineTo(X(l1,zb),Y(zb));x.fill()}
function key(px,py,a,s,k){x.save();x.translate(px,py);x.rotate(a);x.scale(s,s);
rr(-4,0,8,22,2,'#c8c8c8');rr(-21,18,42,72,14,'#bdbdbd');rr(-19,20,38,68,12,k.c);
