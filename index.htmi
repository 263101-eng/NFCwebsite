function draw(){hy=150+S.pv*300;CU=[];EL=[];var cc=0,cp=0,ee=0;for(var u=0;u<=60;u++){CU[u]=cp;EL[u]=ee;cc+=cvv(S.dist+u);cp+=cc;ee+=gz(S.dist+u)}bo=-S.cs*45;var YM=[],mn=1e9;for(var u=0;u<=60;u++){mn=Math.min(mn,Y(1+u));YM[u]=mn}x.save();if(S.fl>0||S.fx>0){var q=(S.fl>0?S.fl*.6:S.fx)*5;x.translate((Math.random()-.5)*q,(Math.random()-.5)*q)}
