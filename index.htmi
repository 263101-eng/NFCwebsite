if(m%2==0){poly([P3(-.2,1.28,z1),P3(.2,1.28,z1),P3(.2,1.28,z2),P3(-.2,1.28,z2)],'#ffe9b0');poly([P3(-1.6,.55,z1),P3(-1.6,.62,z1),P3(-1.6,.62,z2),P3(-1.6,.55,z2)],'#c9a24b');poly([P3(1.6,.55,z1),P3(1.6,.62,z1),P3(1.6,.62,z2),P3(1.6,.55,z2)],'#c9a24b')}}
else scene(m,z1,z2,wz)}
