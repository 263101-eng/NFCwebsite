x.fillStyle='rgba(0,0,0,'+.62*(1-S.lit)+')';x.fillRect(-10,-10,W+20,H+20);
if(S.on){x.fillStyle='#fff';x.font='700 14px sans-serif';x.fillText('거리 '+Math.floor(S.dist)+'m · 최고 '+S.best+'m · '+BN[bi(S.dist)],cx,38)}
if(S.fx>0){x.fillStyle='rgba(164,38,44,'+S.fx*.5+')';x.fillRect(-10,-10,W+20,H+20)}
