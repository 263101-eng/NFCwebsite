else{var bw=.5*s,bh=.27*s;x.fillStyle='rgba(255,50,40,.2)';x.beginPath();x.ellipse(px,yb-bh*.3,bw*.65,bh*.55,0,0,7);x.fill();rr(px-bw/2,yb-bh,bw,bh,bw*.15,'#4a4a52');rr(px-bw*.38,yb-bh*.9,bw*.76,bh*.36,bw*.08,'#15151a');rr(px-bw*.46,yb-bh*.4,bw*.22,bh*.14,2,'#ff3b30');rr(px+bw*.24,yb-bh*.4,bw*.22,bh*.14,2,'#ff3b30')}x.globalAlpha=1});
var vg=x.createRadialGradient(cx,230,120,cx,230,520);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.45)');x.fillStyle=vg;x.fillRect(0,0,W,H);x.fillStyle='rgba(0,0,0,'+.35*S.tun+')';x.fillRect(0,0,W,H);x.fillStyle='#070707';x.beginPath();x.moveTo(0,0);x.lineTo(90,0);x.lineTo(0,300);x.fill();x.beginPath();x.moveTo(W,0);x.lineTo(W-90,0);x.lineTo(W,300);x.fill();x.fillRect(0,0,W,18);
var d=x.createLinearGradient(0,300,0,H);d.addColorStop(0,'#232323');d.addColorStop(1,'#0b0b0b');x.fillStyle=d;x.beginPath();x.moveTo(0,322);x.quadraticCurveTo(cx,298,W,322);x.lineTo(W,H);x.lineTo(0,H);x.fill();
