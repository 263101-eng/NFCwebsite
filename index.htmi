x.strokeStyle='rgba(255,140,100,'+.25*S.pal[28]+')';x.lineWidth=1;x.beginPath();for(var q=-8;q<=8;q++){x.moveTo(X(q*.9,60),Y(60));x.lineTo(X(q*.9,1),by)}for(var n=0;n<30;n++){var zz=1+(Math.floor(S.dist/2)+n)*2-S.dist;if(zz<1)continue;x.moveTo(0,Y(zz));x.lineTo(W,Y(zz))}x.stroke();

for(var n=29;n>=0;n--){var m=Math.floor(S.dist/2)+n,wz=m*2,z1=Math.max(.6,1+wz-S.dist),z2=1+wz+2.03-S.dist,zi=zn(wz),fz=wz/220%1,tn=zi==2&&fz>.1&&fz<.9,br=zi==1&&fz>.1&&fz<.9;
