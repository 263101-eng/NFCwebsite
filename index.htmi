x.fillStyle='#000';x.beginPath();x.arc(SX,SY,11,0,7);x.fill();x.strokeStyle=S.st=='pick'&&Math.sin(S.t*5)>0?'#fff':'#c9a24b';x.lineWidth=2;x.stroke();
x.save();x.translate(cx,WY);x.rotate(S.steer*2.2+S.cs*.9);x.strokeStyle='#171717';x.lineWidth=20;x.beginPath();x.arc(0,0,92,0,7);x.stroke();x.strokeStyle=ac2;x.lineWidth=2;x.beginPath();x.arc(0,0,80,0,7);x.stroke();
